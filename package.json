{
  "name": "herdr-agents-tool",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Start Pi or Claude Code agents in herdr-core terminals and get their reports back.",
  "keywords": [
    "pi-package",
    "herdr"
  ],
  "scripts": {
    "test": "node --test test/core.test.ts",
    "test:e2e": "node --test test/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mod": "tsc -p hooks",
    "validate:mod": "claude plugin validate ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.8.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
