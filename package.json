{
  "name": "herdr-agents-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One narrow Pi tool for starting a Pi agent in a newly created Herdr location.",
  "keywords": ["pi-package", "herdr"],
  "scripts": {
    "test": "bun run test/run.ts",
    "test:integration": "bun run test/integration.ts",
    "typecheck": "tsc --noEmit",
    "test:mod": "claude plugin test .",
    "typecheck:mod": "tsc -p hooks"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.8.3"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
